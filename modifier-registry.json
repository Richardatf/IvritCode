  "machine_semantic_vocabulary": {
    "TERMINATE_SEQUENCE": "Close the complete sequence.",
    "CLOSE_MAJOR_GROUP": "Close a principal nested group.",
    "CLOSE_GROUP": "Close the current group.",
    "CLOSE_MINOR_GROUP": "Close a subordinate group.",
    "SEPARATE": "Create a weak boundary while retaining parent context.",
    "BIND_NEXT": "Bind the current operation to the following operation or group.",
    "BIND_STRONG_NEXT": "Bind tightly to the following operation or group.",
    "CHAIN_NEXT": "Continue a multi-operation phrase without closing context."
  },
